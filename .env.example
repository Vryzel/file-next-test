# =============================================================================
# Operator-only. Visitors never see or set these — the public sandbox
# uses a dedicated throwaway bucket, not a form for AWS keys.
# Copy to .env.local and fill in your values.
# =============================================================================
#
# Two paths are supported: Cloudflare R2 (recommended for free testing)
# or AWS S3 (recommended for production).
#
# Pick ONE provider — only set the vars for the one you're using.
# =============================================================================

# -----------------------------------------------------------------------------
# Common (always required)
# -----------------------------------------------------------------------------

# Which provider: "s3" or "r2"
FILE_NEXT_PROVIDER=r2

# The bucket name (must exist; file-next does NOT create it).
FILE_NEXT_BUCKET=your-test-bucket

# -----------------------------------------------------------------------------
# AWS S3
# -----------------------------------------------------------------------------
# FILE_NEXT_PROVIDER=s3
# FILE_NEXT_REGION=us-east-1
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...

# -----------------------------------------------------------------------------
# Cloudflare R2
# -----------------------------------------------------------------------------
# FILE_NEXT_REGION=auto                       # R2 always uses "auto"
# FILE_NEXT_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# AWS_ACCESS_KEY_ID=<r2-access-key>
# AWS_SECRET_ACCESS_KEY=<r2-secret-key>
#
# Optional: a custom public domain bound in the R2 dashboard.
# FILE_NEXT_PUBLIC_URL=https://files.your-app.com

# -----------------------------------------------------------------------------
# Metadata backend (sqlite for local dev; postgres for prod)
# -----------------------------------------------------------------------------
# Default for v0.1: in-memory. The test project uses the same
# in-memory store so you can iterate without provisioning a DB.
# Uncomment to switch:
#
# FILE_NEXT_ADAPTER=sqlite
# FILE_NEXT_SQLITE_PATH=./data/file-next.sqlite
#
# FILE_NEXT_ADAPTER=postgres
# FILE_NEXT_PG_HOST=localhost
# FILE_NEXT_PG_PORT=5432
# FILE_NEXT_PG_USER=postgres
# FILE_NEXT_PG_DATABASE=file_next_test
# FILE_NEXT_PG_PASSWORD=...